{
  "name": "@terraformes/extractores",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Extractores de datos (GitHub Actions → Supabase). Node 22.18+ corre los .ts directamente.",
  "engines": {
    "node": ">=22.18"
