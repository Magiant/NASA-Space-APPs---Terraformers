# Copia este archivo como .env y llena los valores.
# Las variables VITE_* se incrustan en el bundle del navegador: solo claves PÚBLICAS.

# --- Supabase (Project Settings > API) ---
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica

# --- Algolia (Settings > API Keys) ---
VITE_ALGOLIA_APP_ID=XXXXXXXXXX
VITE_ALGOLIA_SEARCH_KEY=tu-search-only-key
VITE_ALGOLIA_INDEX=missions

# --- Solo para scripts de Node (NUNCA usar prefijo VITE_) ---
ALGOLIA_ADMIN_KEY=tu-admin-key
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
