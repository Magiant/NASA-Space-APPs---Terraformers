# Copia este archivo como .env (en la raíz) y llena los valores. Nunca subas el .env a git.
# Las variables VITE_* se incrustan en el bundle del navegador: solo claves PÚBLICAS.

# --- Web (públicas) ---
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica
VITE_ALGOLIA_APP_ID=XXXXXXXXXX
VITE_ALGOLIA_SEARCH_KEY=tu-search-only-key

# --- Extractores (privadas: NUNCA con prefijo VITE_; en GitHub van como secretos) ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
ALGOLIA_ADMIN_KEY=tu-admin-key

# --- Migraciones (solo GitHub Actions o local; da acceso total a la base) ---
# Supabase > Connect > Session pooler > URI, con la contraseña de la base. Ver docs/migraciones.md
SUPABASE_DB_URL=postgresql://postgres.xxxxxxxx:tu-contraseña@aws-0-region.pooler.supabase.com:5432/postgres

# --- Fuentes que piden cuenta ---
# NASA Earthdata (AppEEARS: ECOSTRESS, SMAP, SRTM, MODIS NDVI). Cuenta gratis en
# https://urs.earthdata.nasa.gov/users/new  — AppEEARS necesita usuario y contraseña (rechaza el token).
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
EARTHDATA_TOKEN=
# Protected Planet (tema 10, áreas protegidas): https://api.protectedplanet.net/request
WDPA_API_TOKEN=
# Tema 10, censo: ruta al Excel del Censo Agropecuario 2014 bajado a mano (no es secreto)
CENSO_EXCEL=

# --- Cuenta admin de la demo (supabase/demo/cargar-demo.mjs). NO es pública: no la ponga en la pantalla de Entrar. ---
DEMO_ADMIN_CLAVE=una-clave-larga-solo-letras-y-numeros
